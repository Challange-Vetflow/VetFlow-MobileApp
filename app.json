{
  "expo": {
    "name": "VetFlow",
    "slug": "vetflow",
    "version": "4.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "vetflow",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F4FBF9",
      "dark": {
        "image": "./assets/splash-dark.png",
        "backgroundColor": "#0E1816"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fiap.vetflow",
      "buildNumber": "4"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.fiap.vetflow",
      "versionCode": 4
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#2A9D8F"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "6f541ab8-8f54-4f8b-86ab-c8f7d060c9ea"
      }
    }
  }
}